---
import Main from '../layouts/Main.astro';
import Grid from '../layouts/Grid.astro';
import Service from '../components/Service.astro';

const services = [
  { name: 'pi-hole admin', link: '/admin', desc: 'Admin panel for pi-hole' },
];

// let data: any = null;

// setTimeout(async () => {
//   data = await fetch('http://localhost:3000/api/system').then((res) => res.json()).then((data) => console.log(data)).catch((err) => console.error(err));
// }, 3000);
---

<Main>
	<Fragment slot="header">
		<span>header content</span>
		<!-- <span>Full load: {data?.fullLoad}%</span> -->
	</Fragment>

	<Grid gridSize={5}>
		{services.map((service) => (
			<Service name={service.name} link={service.link} desc={service.desc} />
		))}
	</Grid>

	<Fragment slot="aside">
		<span>aside content</span>
	</Fragment>
</Main>

<script>
	import type { Root } from "@/interfaces";

	// make a recursive call to the system function every 3 seconds
	setInterval(() => {
		fetch('http://localhost:3000/api/system').then((res) => res.json()).then((data: Root) => {
			console.log(data);
		}).catch((err) => console.log(err));
	}, 3000);

	
</script>