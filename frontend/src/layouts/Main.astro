---
// import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Raspi Dashboard</title>
	</head>
	<body>
		<header>
			<slot name="header" />
		</header>
		<aside>
			<slot name="aside" />
		</aside>
		<main class="content">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	/* Inter — body (variable, 100–900) */
	@font-face {
	font-family: "Inter";
	font-style: normal;
	font-weight: 100 900;
	font-display: swap;
	src: url("/fonts/inter-latin.woff2") format("woff2");
	unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	:root {
	--font-body: "Inter", sans-serif;

	--color-neutral-white: #f7f9fb;
	--color-neutral-black: #000004;
	--color-neutral-dark: #353838;
	--color-neutral-light: #8aa5ad;

	--color-red-light: #d12027;
	--color-red-dark: #8d191b;

	--color-blue-dark: #081d62;
	
	--primary-color: #3b82f6;
   --secondary-color: #0f172a;
   --terciary-color: #94acb8;
   --neutral-color: #f8fafc;

	--background-color: #202020;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: var(--color-neutral-black);
		color: var(--color-neutral-white);
		color-scheme: dark;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		/* `clip` corta overflow sin romper sticky (a diferencia de `hidden`). */
		overflow-x: clip;
		scrollbar-width: thin;
		scrollbar-color: var(--color-red-light) var(--color-blue-dark);
		font-family: var(--font-body);

		&::-webkit-scrollbar {
			width: 10px;
		}

		&::-webkit-scrollbar-track {
			background: var(--color-blue-dark);
		}

		&::-webkit-scrollbar-thumb {
			background: linear-gradient(
				180deg,
				var(--color-red-light) 0%,
				var(--color-red-dark) 100%
			);
			border-radius: 999px;
			border: 2px solid var(--color-blue-dark);
		}

		&::-webkit-scrollbar-thumb:hover {
			background: var(--color-red-light);
		}

		body {
			height: 100%;
			width: 100%;
			display: grid;
			grid-template-columns: 400px 1fr;
			grid-template-rows: 48px 1fr;
			grid-template-areas: "header header" "aside main";

			header {
				grid-area: header;
			}

			aside {
				grid-area: aside;
			}

			main.content {
				grid-area: main;
				padding: 24px;
			}
		}

		/* Anton solo existe a 400: forzar peso y bloquear faux-bold. */
		.font-display {
			font-weight: 400;
			font-synthesis-weight: none;
		}

		.service {
			display: flex;
			flex-direction: column;
			align-items: center;
			background-color: #484848;
			border-radius: 8px;
			padding: 1rem;
			transition: box-shadow 250ms ease;

			&:hover {
				box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
			}

			h2 {
				margin: 0;
			}

			p {
				text-align: start;
				flex: 1;
				width: 100%;
			}
		}
	}
</style>