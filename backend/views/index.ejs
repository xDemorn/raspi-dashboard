<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title>Raspi Dashboard</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="container">
    <h1>System Monitor</h1>
    <div id="system-info">Loading...</div>
  </div>

  <script>
    const eventSource = new EventSource('/api/system-stream');

    eventSource.onmessage = (event) => {
      const data = JSON.parse(event.data);
      console.log(data)
      updateUI(data);
    };

    eventSource.onerror = (error) => {
      console.error('SSE Error:', error);
      document.getElementById('system-info').innerHTML = 'Connection lost';
    };

    function updateUI(data) {
      const infoDiv = document.getElementById('system-info');
      
      let html = '';
      
      if (data.cpu) {
        html += `<div class="info-section">
          <span class="label">CPU Brand:</span>
          <span class="value">${data.cpu.brand}</span>
        </div>`;
      }
      
      if (data.mem) {
        const memUsedGB = (data.mem.used / 1024 / 1024 / 1024).toFixed(2);
        const memTotalGB = (data.mem.total / 1024 / 1024 / 1024).toFixed(2);
        html += `<div class="info-section">
          <span class="label">Memory:</span>
          <span class="value">${memUsedGB}GB / ${memTotalGB}GB</span>
        </div>`;
      }
      
      if (data.os) {
        html += `<div class="info-section">
          <span class="label">OS:</span>
          <span class="value">${data.os.distro}</span>
        </div>`;
      }
      
      if (data.diskLayout && data.diskLayout.length > 0) {
        const disk = data.diskLayout[0];
        html += `<div class="info-section">
          <span class="label">Disk:</span>
          <span class="value">${(disk.size / 1024 / 1024 / 1024).toFixed(2)}GB</span>
        </div>`;
      }
      
      infoDiv.innerHTML = html;
    }
  </script>
</body>
</html>